# Normalise line endings so Unity YAML diffs stay reviewable on Windows, macOS and Linux.
* text=auto

# Unity YAML assets (force text serialisation is enabled in EditorSettings)
*.unity text
*.prefab text
*.asset text
*.mat text
*.controller text
*.anim text
*.meta text
*.asmdef text
*.json text
*.md text
*.shader text
*.cginc text
*.hlsl text

# C# sources
*.cs text diff=csharp

# Binary art and build artefacts
*.png binary
*.jpg binary
*.jpeg binary
*.psd binary
*.tga binary
*.fbx binary
*.wav binary
*.mp3 binary
*.ogg binary
*.dll binary
*.so binary
*.a binary
*.bundle binary
